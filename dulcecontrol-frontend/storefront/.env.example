# ========================================
# CONFIGURACIÓN STOREFRONT - DULCECONTROL
# ========================================

# Entorno de ejecución
# Valores: development, production
VITE_ENV=development

# URL del backend API
# Desarrollo local: http://localhost:2250 (puerto asignado)
# Producción (VPS): https://api.informaticapp.com (ajustar según tu VPS)
VITE_API_URL=http://localhost:2250

# ========================================
# MULTITENANCY - SOLO PARA DESARROLLO
# ========================================
# En producción, la tienda se detecta automáticamente por:
# - Subdominio: panaderia-rosita.dulcecontrol.com
# - Dominio personalizado: www.panaderiarosita.pe
#
# En desarrollo local, especifica el ID de tienda manualmente:
VITE_TIENDA_ID=1

# ========================================
# OPCIONALES
# ========================================
# Clave pública de Stripe (para checkout)
# VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx

# Google Analytics
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX
